# Model routing: mock | auto | live
MODEL_MODE=mock
MODEL_TIMEOUT_SECONDS=30
SECAGENT_PORT=18080

# DeepSeek (leave empty for Mock mode)
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_STYLE=auto
DEEPSEEK_REASONING_EFFORT=high
# Stage-level reasoning effort for the frequent short stages (opencode-go
# style only; the official API always enables thinking). Lowering these drops
# the 100+ second decomposition latency for every message; synthesis keeps the
# configured effort above for answer quality.
DEEPSEEK_DECOMPOSE_REASONING_EFFORT=low
DEEPSEEK_SUBTASK_REASONING_EFFORT=low

# Zhipu GLM (leave empty for Mock mode)
GLM_API_KEY=
GLM_API_KEY_FILE=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2

# PostgreSQL, Redis, workers, and job leases
DATABASE_URL=postgresql+psycopg://secagent:secagent@postgres/secagent
REDIS_URL=redis://redis:6379/0
WORKER_CONCURRENCY=3
JOB_LEASE_SECONDS=90
JOB_HEARTBEAT_SECONDS=15
JOB_AUTO_RETRIES=1

# JWT and cookie settings
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
COOKIE_SECURE=false
JWT_SIGNING_KEY=
JWT_SIGNING_KEY_FILE=
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
PROVIDER_CREDENTIAL_ENCRYPTION_KEY_FILE=

# Persistence and bounded uploads
DATA_DIR=./data
UPLOAD_MAX_BYTES=10485760
ARCHIVE_MAX_FILES=200
ARCHIVE_MAX_BYTES=52428800

# Passive Web allowlist (comma-separated exact hostnames)
WEB_ALLOWED_HOSTS=web-demo

# Execution budgets reserved for operator policy
MAX_STEPS_PER_TASK=20
MAX_REPLANS=2
TASK_TIMEOUT_SECONDS=300

# Per-task model budgets
MAX_MODEL_CALLS_PER_TASK=8
MAX_INPUT_TOKENS_PER_TASK=120000
MAX_OUTPUT_TOKENS_PER_TASK=24000
