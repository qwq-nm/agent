# Model routing: mock | auto | live
MODEL_MODE=mock
MODEL_TIMEOUT_SECONDS=30
SECAGENT_PORT=18080

# DeepSeek (leave empty for Mock mode)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Zhipu GLM (leave empty for Mock mode)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# Persistence and bounded uploads
DATABASE_URL=sqlite:///./data/secagent.db
DATA_DIR=./data
UPLOAD_MAX_BYTES=10485760
ARCHIVE_MAX_FILES=200
ARCHIVE_MAX_BYTES=52428800

# Passive Web allowlist (comma-separated exact hostnames)
WEB_ALLOWED_HOSTS=web-demo

# Execution budgets reserved for operator policy
MAX_STEPS_PER_TASK=20
MAX_REPLANS=2
TASK_TIMEOUT_SECONDS=300
