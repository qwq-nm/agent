+        ).message.id
+
+    with factory() as session:
+        if state_kind == "new":
+            pending = UserRow(
+                id=str(uuid4()),
+                username=f"pending-{uuid4()}",
+                password_hash="unused",
+                role=UserRole.ANALYST.value,
+            )
+            session.add(pending)
+        else:
+            pending = session.get(UserRow, bob.id)
+            assert pending is not None
+            if state_kind == "dirty":
+                pending.username = "bob-dirty"
+            else:
