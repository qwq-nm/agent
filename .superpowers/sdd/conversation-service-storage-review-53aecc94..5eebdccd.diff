+    """COMMIT outcome is uncertain and filesystem reconciliation is required."""
+
+
+@dataclass(frozen=True)
+class _ReplayState:
+    message: ConversationMessageRead
+    attachments: list[AttachmentRead]
+    turn: ConversationTurnRead
