+            "events": 1,
+            "jobs": 0,
+        }
+        with env.factory() as session:
+            row = session.get(ConversationRow, conversation.id)
+            assert row is not None
+            assert row.next_message_sequence == 2
+            assert row.next_turn_plan_version == 2
+    finally:
+        Base.metadata.drop_all(env.engine)
+        env.close()
