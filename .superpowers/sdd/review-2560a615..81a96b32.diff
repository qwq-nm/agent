+        for statement in statements
+        if statement.startswith(("SELECT", "UPDATE", "INSERT", "DELETE"))
+    )
+    assert first_dml.startswith("UPDATE CONVERSATIONS")
+    assert "RETURNING" in first_dml
+    assert "OWNER_ID" in first_dml
