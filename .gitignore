# Local environment and credentials
.env
.env.*
!.env.example

# Runtime secrets. Keep documented examples, never commit real keys.
secrets/*
!secrets/*.example

# Runtime data and local databases
data/
*.db
*.sqlite
*.sqlite3
x.db

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
*.egg-info/
.venv/
venv/

# Node / frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Browser and test artifacts
test-results/
playwright-report/

# Local tool state
.superpowers/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
